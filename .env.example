# Supabase (required)
# Find these in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: used server-side only (seed scripts, admin tasks). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI providers for smarter command parsing / summaries.
# If neither is set, the app uses a deterministic built-in parser and still works fully.
AI_PROVIDER=fallback
# AI_PROVIDER=openai
OPENAI_API_KEY=
# AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
