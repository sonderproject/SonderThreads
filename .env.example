# Postgres connection string (required).
# In Vercel: project -> Storage tab -> Create Database -> Postgres. This
# injects POSTGRES_URL automatically; no need to set it manually there.
# Locally, point this at any Postgres instance (see README for setup):
POSTGRES_URL=postgres://user:password@localhost:5432/client_command_center

# The old shared password from before accounts existed (optional). Entering
# it on the sign-up page claims all data created before accounts, once.
# Safe to remove after that.
APP_PASSWORD=

# Optional AI providers for smarter command parsing / summaries.
# If neither is set, the app uses a deterministic built-in parser and still works fully.
AI_PROVIDER=fallback
# AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_API_KEY also powers voice input where the browser has no built-in
# speech recognition (notably iPhone home-screen apps). Setting it does NOT
# switch command parsing to OpenAI — only AI_PROVIDER does that.
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Forgot-password emails (optional; the "Forgot password?" link is hidden
# until both are set). Get a key at resend.com and verify your domain there.
RESEND_API_KEY=
# EMAIL_FROM=sonderthreads <no-reply@sonderthreads.com>
EMAIL_FROM=
# Public URL used in emailed links. Defaults to Vercel's production domain.
# APP_URL=https://sonderthreads.com

# Push notifications (optional; free, no outside service). Generate a key
# pair once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
VAPID_SUBJECT=

# Text-message reminders via Twilio (optional; until set, texts are only
# printed to the server log). US numbers need an A2P 10DLC registration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use a Messaging Service (recommended) or a single Twilio number:
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=

# Protects /api/cron/reminders, which sends due-task reminders. Vercel Cron
# sends it automatically; any outside cron service must send
# "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
