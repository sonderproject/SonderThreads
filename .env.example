# Postgres connection string (required).
# In Vercel: project -> Storage tab -> Create Database -> Postgres. This
# injects POSTGRES_URL automatically; no need to set it manually there.
# Locally, point this at any Postgres instance (see README for setup):
POSTGRES_URL=postgres://user:password@localhost:5432/client_command_center

# Optional AI providers for smarter command parsing / summaries.
# If neither is set, the app uses a deterministic built-in parser and still works fully.
AI_PROVIDER=fallback
# AI_PROVIDER=openai
OPENAI_API_KEY=
# AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
